<body>

    <header>
        <h1>Gestión de Recursos Humanos</h1>
        <p>Enfoque Legal y Operativo en la Industria Hotelera y Gastronómica de Guatemala</p>
    </header>

    <nav>
        <ul>
            <li><a href="#planificacion">Planificación</a></li>
            <li><a href="#analisis">Análisis de Puestos</a></li>
            <li><a href="#reclutamiento">Reclutamiento</a></li>
            <li><a href="#contratacion">Contratación & Leyes</a></li>
